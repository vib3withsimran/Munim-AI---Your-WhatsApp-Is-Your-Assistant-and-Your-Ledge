# ─────────────────────────────────────────────
#  Munim AI — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Twilio WhatsApp API ───────────────────────
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# Twilio WhatsApp Sandbox number (default: whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Owner's personal WhatsApp number ─────────
# Used to forward escalations and send daily summaries.
# Format: international without '+' e.g. 919876543210
OWNER_WHATSAPP_NUMBER=918587859710

# ── Google Sheets ─────────────────────────────
# Path to the service-account JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON=./backend/data/service_account.json
# The ID from the Google Sheet URL
GOOGLE_SHEET_ID=1QbB8dqZ8bTt0PDL1S-MakN4BTqJpI-E-LEMhFdYlTNo

# ── Gemini (Google AI) ────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── Groq / Whisper (audio fallback) ──────────
GROQ_API_KEY=

# ── Application ───────────────────────────────
APP_ENV=development
APP_SECRET_KEY=munim-ai-hackathon-secret-2026
LOG_LEVEL=INFO
DRY_RUN=0

# ── SQLite database path ──────────────────────
DATABASE_URL=sqlite:///./backend/data/munim.db

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
