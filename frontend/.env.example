# ─────────────────────────────────────────────────────────────
# Munim AI Frontend — Environment Configuration Example
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env or .env.local to version control.
# ─────────────────────────────────────────────────────────────

# Supabase Project URL (found in Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anon Client Key (Safe for browser exposure)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Munim AI FastAPI Backend URL (default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

